    "@remotion/renderer": "4.0.529",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19",
    "marked": "15.0.12",
    "typescript": "^5"
  }
}
