{
  "name": "textbook-videos",
  "version": "0.1.0",
  "private": true,
  "description": "教科書の図解動画（Remotion）。coffee-community の説明動画と同じ仕組みで作り、wecoffee-os の教科書に埋め込む",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
